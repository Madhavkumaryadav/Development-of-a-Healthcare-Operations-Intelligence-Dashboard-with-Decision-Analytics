# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit credentials to the repo.

# MongoDB Atlas connection string (M0 free tier is enough). Create a
# dedicated database user with read/write access to the healthsentinel
# database only, and add your IP (or 0.0.0.0/0 with strong auth) to the
# cluster allowlist. Example:
#   MONGO_URI=mongodb+srv://<db-user>:<db-password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Target database name (optional; defaults to "healthsentinel").
MONGO_DB=healthsentinel

# Optional grounded Q&A configuration.
ATLAS_VECTOR_INDEX=rag_chunks_vector
EMBEDDING_MODEL=
LLM_PROVIDER=
GEMINI_API_KEY=